# 当前运行环境：test / staging / prod
ENV=test

# 各环境 API 地址和 Token（请在本机 .env 中填写真实值）
TEST_BASE_URL=https://test.example.com
TEST_AUTH_TOKEN=REPLACE_WITH_TEST_TOKEN

STAGING_BASE_URL=
STAGING_AUTH_TOKEN=

PROD_BASE_URL=
PROD_AUTH_TOKEN=

# 设备信息：按测试环境实际要求填写；不需要时可留空/使用默认值
DEVICE_TYPE=ios
DEVICE_BRAND=Apple
DEVICE_MANUFACTURER=Apple
DEVICE_MODEL=iPad Pro 12-Inch 3
DEVICE_SYSTEM_NAME=iPadOS
DEVICE_OS_VERSION=18.5
DEVICE_ID=REPLACE_WITH_TEST_DEVICE_ID
FCM_DEVICE_TOKEN=
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
APP_PACKAGE_NAME=com.example.autotest
LOGIN_FINGERPRINT=

# 飞书机器人（不使用通知时可留空）
LARK_WEBHOOK_URL=
LARK_NOTIFY_ON_SUCCESS=false

# 语言
LANGUAGE=zh
LANG=zh
